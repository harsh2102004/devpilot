# DevPilot Docker Compose Global Environment Template
# Copy this file to .env at the repository root to configure all orchestrated services

# -------------------------------------------------------------
# Global Project Settings
# -------------------------------------------------------------
COMPOSE_PROJECT_NAME=devpilot
NODE_ENV=production

# -------------------------------------------------------------
# Port Mappings
# -------------------------------------------------------------
CLIENT_PORT=5173
SERVER_PORT=5000
MONGO_PORT=27017
REDIS_PORT=6379

# -------------------------------------------------------------
# Databases & Messaging (Internal Docker Network)
# -------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017/devpilot
REDIS_HOST=redis
REDIS_PORT=6379

# -------------------------------------------------------------
# Security & Auth Tokens (Minimum 32 characters required)
# -------------------------------------------------------------
ACCESS_TOKEN_SECRET=replace_with_your_own_secure_secret_min_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_your_own_secure_secret_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# -------------------------------------------------------------
# AI & Vector DB Integration
# -------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=devpilot-codebase
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -------------------------------------------------------------
# GitHub OAuth / Octokit
# -------------------------------------------------------------
GITHUB_TOKEN=

