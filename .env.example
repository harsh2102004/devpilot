# DevPilot Docker Compose Global Environment Template
# Copy this file to .env at the repository root to configure orchestrated services
# All secrets marked "min 32 chars" are strictly validated on startup.

# -------------------------------------------------------------
# Global Project Settings
# -------------------------------------------------------------
COMPOSE_PROJECT_NAME=devpilot
NODE_ENV=production

# -------------------------------------------------------------
# Port Mappings
# -------------------------------------------------------------
CLIENT_PORT=5173
SERVER_PORT=5000

# -------------------------------------------------------------
# Databases & Messaging (Internal Docker Network Credentials)
# -------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=devpilot_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_secure_mongo_password_32_chars!
MONGO_URI=mongodb://devpilot_admin:replace_with_secure_mongo_password_32_chars!@mongo:27017/devpilot?authSource=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password_32_chars!

# -------------------------------------------------------------
# Security & Auth Tokens (Minimum 32 characters required)
# -------------------------------------------------------------
ACCESS_TOKEN_SECRET=replace_with_your_own_jwt_access_secret_min_32_characters!
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_your_own_jwt_refresh_secret_min_32_characters!
REFRESH_TOKEN_EXPIRY=7d
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -------------------------------------------------------------
# Sandboxed Test Execution Engine
# -------------------------------------------------------------
ALLOW_UNSAFE_LOCAL_SANDBOX=false

# -------------------------------------------------------------
# Vector DB (Pinecone)
# -------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=devpilot

# -------------------------------------------------------------
# LLM Providers (OpenAI / Moonshot)
# -------------------------------------------------------------
# Note: If no API key is provided, DevPilot runs in OFFLINE mode:
# - Embeddings fall back to deterministic 3072-dim polynomial hash vectors (NOT real AI embeddings)
# - Code chat falls back to heuristic template-generated answers citing retrieved AST context (NOT real AI completions)
OPENAI_API_KEY=
MOONSHOT_API_KEY=

# -------------------------------------------------------------
# GitHub Integration
# -------------------------------------------------------------
GITHUB_TOKEN=
