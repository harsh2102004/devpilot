# DevPilot Server Environment Configuration Template
# Copy this file to .env and configure your local or container secrets.
# IMPORTANT: All secrets marked "min 32 chars" are strictly validated on startup.

# -------------------------------------------------------------
# Server & Network Configuration
# -------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------------
# Database & Cache (MongoDB & Redis)
# -------------------------------------------------------------
# MongoDB connection URI (must be at least 32 characters)
MONGO_URI=mongodb://127.0.0.1:27017/devpilot_database_instance_32chars!

# Redis connection settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password_32_chars!

# -------------------------------------------------------------
# Security & JWT Authentication (Minimum 32 characters required)
# -------------------------------------------------------------
ACCESS_TOKEN_SECRET=replace_with_your_own_jwt_access_secret_min_32_characters!
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_your_own_jwt_refresh_secret_min_32_characters!
REFRESH_TOKEN_EXPIRY=7d

# AES-256-GCM Encryption Key for GitHub Personal Access Tokens (min 32 characters)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -------------------------------------------------------------
# Sandboxed Test Execution Engine
# -------------------------------------------------------------
# In dev only: set to "true" to allow process-isolated execution when Docker daemon is stopped.
# In production: must be "false" to enforce strict Docker container isolation.
ALLOW_UNSAFE_LOCAL_SANDBOX=false

# -------------------------------------------------------------
# Vector Database (Pinecone)
# -------------------------------------------------------------
# Required for live vector indexing. If omitted, mock vector storage is used.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=devpilot

# -------------------------------------------------------------
# LLM Providers (OpenAI / Moonshot)
# -------------------------------------------------------------
# Note: If no API key is provided, DevPilot runs in OFFLINE mode:
# - Embeddings fall back to deterministic 3072-dim polynomial hash vectors (NOT real AI embeddings)
# - Code chat falls back to heuristic template-generated answers citing retrieved AST context (NOT real AI completions)
OPENAI_API_KEY=
MOONSHOT_API_KEY=

# -------------------------------------------------------------
# GitHub Integration (Octokit)
# -------------------------------------------------------------
# Optional fallback GitHub personal access token (users can also securely store their own token in settings)
GITHUB_TOKEN=
