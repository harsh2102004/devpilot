# DevPilot Server Environment Configuration Template
# Copy this file to .env and provide your secrets

# Server & Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGO_URI=mongodb://mongo:27017/devpilot
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_change_in_production_min32chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_change_in_production_min32chars
REFRESH_TOKEN_EXPIRY=7d
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_32_bytes_or_hex_min32chars

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=devpilot-codebase
PINECONE_ENVIRONMENT=us-east-1

# LLM Providers (At least one key required for live AI debugging; fallback mode active if omitted)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub OAuth & Octokit Integration (Optional for local testing; needed for live PR creation)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

